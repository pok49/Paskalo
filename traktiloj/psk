#!/usr/bin/env perl
use strict;
use warnings;
use utf8;  # ← source file contains UTF-8 literals (ĉ, ŭ, ŝ)
use open ':std', ':encoding(UTF-8)';
use Getopt::Std;
our ($opt_A, $opt_o, $opt_3, $opt_h);

getopts('o:A3h') or die usage();
if ($opt_h) {
    print usage();
    exit 0;
}

use Encode qw(:fallbacks);
use PerlIO::encoding;
$PerlIO::encoding::fallback = Encode::FB_DEFAULT;  # → '?'

getopts('o:A');
my $infile = shift @ARGV;
$infile //= '-';
#====== read input:
my $in_fh;
if ($infile ne '-') {
    open my $in, '<', $infile or die "Fiaskis malfermo de '$infile': $!\n";
    binmode($in, ':raw:encoding(iso-8859-3)') if $infile =~ /\bl3\b/i;
    $in_fh = $in;
} else {
    $in_fh = \*STDIN;
}
local $/;
my $text = <$in_fh>;
# ... the substitutions: ...
# prepend & to aux, do, to ...:
$text =~ s/(?:'(?:[^']|'')*'|(?<!:)\{[^}]*\})(*SKIP)(*F)|(?<!&)\b(aux|do|to)\b/&$1/gi;

my %map = ("\x{108}" => 'CX', "\x{124}" => 'HX', "\x{11C}" => 'GX',
           "\x{134}" => 'JX', "\x{15C}" => 'SX', "\x{16C}" => 'UX',
           "\x{109}" => 'cx', "\x{125}" => 'hx', "\x{11D}" => 'gx',
           "\x{135}" => 'jx', "\x{15D}" => 'sx', "\x{16D}" => 'ux',
           "\x{AC}" => 'NE',  "\x{D7}" => '*',   "\x{F7}" => 'DIV',
           "\x{2264}" =>'<=', "\x{2265}"=> '>=',  "\x{2260}"=>'<>',
           "\x{2191}" =>'^',  "\x{2197}"=> 'SUPRE', "\x{2198}"=> 'SUBE',
           "\x{221A}" =>'Rad');
my $keys = join '|', map { quotemeta }
    sort { length $b <=> length $a } keys %map;
$text =~ s/(?:'(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*"|{(?:[^}\\]|\\.)*})(*SKIP)(*F)|($keys)/$map{$1}/gu;

$text =~ s/(?:\{[^}]*\})(*SKIP)(*F)|\b(PROGRAMO)\b/\{\$INCLUDE 'makrooj.inc'\} $1/i;
if ($opt_3) {
    $text =~ s/(?:\} PROGRAMO\b)(?: |\{[^}]*\})*(*SKIP)(*F)|;/; UZAS cp8859_3;/i;
}
#Pri $outfile:
my $outfile;
if ($opt_o) { $outfile = $opt_o; }
elsif ($opt_A) { $outfile = '-' }
else {
    use File::Basename;
    $outfile = basename($infile);
    $outfile =~ s/\.[^.]+$/.pas/;
    $outfile = 'l3-' . $outfile if ($opt_3);
    $outfile = '/tmp/' . $outfile;
}
# Now let's print $text:
my $out_fh;
if ($outfile ne '-') {
    open my $out, '>', $outfile or die "Fiaskis malfermo de '$outfile': $!\n";
    binmode($out, ':raw:encoding(iso-8859-3)') if $opt_3;
    $out_fh = $out;
} else {
    $out_fh = \*STDOUT;
}
print $out_fh $text;
close $out_fh or die "La fermo fiaskis: $!\n" if $outfile ne '-';
exit if $opt_A;
# The ifpc invocation:
my $inc_dir = "$ENV{HOME}/.local/share/psk";
my $filtrilo = '';
if ($opt_3) {
    $ENV{LC_ALL} = 'eo'; # Now luit shall filter between UTF-8 and Latin-3
    $filtrilo = "luit -encoding 'ISO 8859-3'";
# -encoding is redundant if the locale ‹eo› is installed. But it may not be installed.
} else {
    $ENV{LC_ALL} = 'eo.utf-8';
}
exec("$filtrilo ifpc -I$inc_dir @ARGV $outfile")
    or die "ifpc fiaskis / ifpc failed: $!";
#-------------
sub usage {
    return <<'EOF';
Uzmaniero: psk [opcioj] <enigo>
Usage: psk [options] <input>

Opcioj -- Options:
  -3          Traduku en la Latinon-3an (kaj rulu en tiu kodo se -A malestas).
              Preprocess to Latin-3 (and use it at run time if -A is absent).
  -A          Nur antaŭtraktu (askiigu por ifpc). Sen -o, eligu al dosiero/dukto
              Preprocess only (without -o output to file/stdout)
  -o DOSIERO  DOSIERO por la antaŭtraktila eligo; ne plu traktu nek rulu.
              DOSIERO file for the preprocessor output; no compilation, no run.
  -h          Eligu ĉi tiun helpon / Show this help

Sen -A, la askiigita programo estas transigota al ifpc kun la
ceteraj argumentoj.
Without -A, preprocessed output is submitted to ifpc with remaining args.
EOF
}

